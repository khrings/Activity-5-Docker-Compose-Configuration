services:
  platform_docker-app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: khricia-app
    ports:
      - "8000:8000"
    environment:
      APP_ENV: dev
      APP_SECRET: ${APP_SECRET}
      DATABASE_URL: "mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@khricia-db:3306/${MYSQL_DATABASE}?serverVersion=8.0.32&charset=utf8mb4"
    volumes:
      - .:/app
    depends_on:
      - platform_docker-db
    networks:
      - platform-network
    working_dir: /app

  platform_docker-db:
    image: mysql:8.0
    container_name: khricia-db
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
    ports:
      - "3307:3306"
    volumes:
      - platform-db-data:/var/lib/mysql
    networks:
      - platform-network
    healthcheck:
      test: [ "CMD", "mysqladmin", "ping", "-h", "localhost" ]
      timeout: 20s
      retries: 10

  platform_docker-phpmyadmin:
    image: phpmyadmin/phpmyadmin
    container_name: khricia-phpmyadmin
    environment:
      PMA_HOST: khricia-db
      PMA_USER: ${MYSQL_USER}
      PMA_PASSWORD: ${MYSQL_PASSWORD}
      PMA_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    ports:
      - "8081:80"
    depends_on:
      - platform_docker-db
    networks:
      - platform-network

volumes:
  platform-db-data:

networks:
  platform-network:
    driver: bridge
